@page
@model Stok_Yonetim.Pages.UrunDuzenleModel
@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="dashboard-container" style="max-width: 600px;">
    <h2>✏️ Ürün Bilgilerini Düzenle</h2>

    <div class="table-container">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="DuzenlenenUrun.UrunKod" />

            <div style="text-align: center; margin-bottom: 20px;">
                @if (!string.IsNullOrEmpty(Model.DuzenlenenUrun.Fotograf))
                {
                    <img src="@Model.DuzenlenenUrun.Fotograf" style="width: 150px; height: 150px; object-fit: cover; border-radius: 8px; border: 2px solid #3498db; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
                    <p style="font-size: 12px; color: #7f8c8d; margin-top: 5px;">Mevcut Ürün Görseli</p>
                }
            </div>

            <div style="margin-bottom: 15px;">
                <label style="font-weight: bold; color: #2c3e50;">Ürün Adı:</label><br />
                <input type="text" asp-for="DuzenlenenUrun.Ad" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px;" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="font-weight: bold; color: #2c3e50;">Kategori:</label><br />
                <select asp-for="DuzenlenenUrun.Kategori" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px;">
                    <option value="Dış Yıkama">Dış Yıkama</option>
                    <option value="İç Temizlik">İç Temizlik</option>
                    <option value="Boya Koruma">Boya Koruma</option>
                    <option value="Aksesuar">Aksesuar</option>
                </select>
            </div>

            <div style="margin-bottom: 15px;">
                <label style="font-weight: bold; color: #2c3e50;">Fiyat (TL):</label><br />
                <input type="number" step="0.01" asp-for="DuzenlenenUrun.Fiyat" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px;" />
            </div>

            <div style="margin-bottom: 15px;">
                <label style="font-weight: bold; color: #2c3e50;">Mevcut Stok Miktarı:</label><br />
                <input type="number" asp-for="DuzenlenenUrun.StokMiktari" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px;" />
            </div>

            <div style="margin-bottom: 25px; background-color: #f1f2f6; padding: 15px; border-radius: 5px; border: 1px dashed #ced6e0;">
                <label style="font-weight: bold; color: #2c3e50;">Yeni Fotoğraf Yükle (İsteğe Bağlı):</label><br />
                <span style="font-size: 12px; color: #7f8c8d;">Eğer mevcut fotoğrafı değiştirmek istemiyorsanız burayı boş bırakın.</span>
                <input type="file" asp-for="YeniFotograf" accept="image/*" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px; background-color: white;" />
            </div>

            <button type="submit" class="btn-add" style="width: 100%; font-size: 16px; padding: 12px; background-color: #f39c12; color: white; border: none; border-radius: 5px; cursor: pointer;">Değişiklikleri Kaydet</button>
            <a href="/" style="display: block; text-align: center; margin-top: 15px; color: #e74c3c; text-decoration: none; font-weight: bold;">İptal ve Ana Sayfaya Dön</a>
        </form>
    </div>
</div>