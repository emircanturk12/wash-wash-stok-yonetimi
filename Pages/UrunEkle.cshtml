@page
@model Stok_Yonetim.Pages.UrunEkleModel
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div class="dashboard-container" style="max-width: 600px;">
    <h2>Sisteme Yeni Ürün Ekle</h2>
    
    <div class="table-container">
        <form method="post" enctype="multipart/form-data">
            <div style="margin-bottom: 15px;">
                <label style="font-weight: bold; color: var(--primary);">Ürün Adı:</label><br />
                <input type="text" asp-for="YeniUrun.Ad" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px;" placeholder="Örn: Seramik Kaplama Spreyi" />
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="font-weight: bold; color: var(--primary);">Kategori:</label><br />
                <select asp-for="YeniUrun.Kategori" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px;">
                    <option value="">Kategori Seçiniz...</option>
                    <option value="Dış Yıkama">Dış Yıkama</option>
                    <option value="İç Temizlik">İç Temizlik</option>
                    <option value="Boya Koruma">Boya Koruma</option>
                    <option value="Aksesuar">Aksesuar</option>
                </select>
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="font-weight: bold; color: var(--primary);">Fiyat (TL):</label><br />
                <input type="number" step="0.01" asp-for="YeniUrun.Fiyat" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px;" />
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="font-weight: bold; color: var(--primary);">Başlangıç Stok Miktarı:</label><br />
                <input type="number" asp-for="YeniUrun.StokMiktari" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px;" />
            </div>

            <div style="margin-bottom: 25px;">
                <label style="font-weight: bold; color: var(--primary);">Ürün Fotoğrafı (İsteğe Bağlı):</label><br />
                <input type="file" asp-for="YuklenenFotograf" accept="image/*" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; margin-top: 5px; background-color: #f8f9fa;" />
            </div>
            
            <button type="submit" class="btn-add" style="width: 100%; font-size: 16px; padding: 12px; background-color: #2ecc71; color: white; border: none; border-radius: 5px; cursor: pointer;">Ürünü Kaydet</button>
            <a href="/" style="display: block; text-align: center; margin-top: 15px; color: #e74c3c; text-decoration: none; font-weight: bold;">İptal ve Ana Sayfaya Dön</a>
        </form>
    </div>
</div>